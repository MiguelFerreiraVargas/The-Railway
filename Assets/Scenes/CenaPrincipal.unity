  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 027206669f9527248a1a611b91d98e03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jornal
  acao: LER
  nomeJornal: "Almanaque Ferrovi\xE1rio"
  data: "Edi\xE7\xE3o comemorativa, 1998"
  manchete: George Stephenson, o pai das ferrovias
  corpo: "George Stephenson nasceu em 1781, em Wylam, na Inglaterra, filho de um
    mineiro. S\xF3 aprendeu a ler aos 18 anos, estudando \xE0 noite.\n\nCome\xE7ou
    cuidando de m\xE1quinas nas minas de carv\xE3o e passou a construir locomotivas
    a vapor. Em 1825, a sua Locomotion n\xBA 1 puxou o primeiro trem p\xFAblico a
    vapor, na ferrovia Stockton\u2013Darlington.\n\nEm 1829, a locomotiva Rocket,
    feita com o filho Robert, venceu as provas de Rainhill. A bitola que ele usou,
    1.435 mm, ainda \xE9 a mais comum do mundo."
  flag: mundo.doc.stephenson1
  falaDepois: "Stephenson... eu conhe\xE7o essa hist\xF3ria. Eu lia isso na esta\xE7\xE3o,
    nos dias de chuva."
