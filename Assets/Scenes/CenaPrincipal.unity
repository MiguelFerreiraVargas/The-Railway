  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jornal
  acao: LER
  nomeJornal: "Secretaria de Sa\xFAde"
  data: Maio de 2020
  manchete: "V\xEDrus Violeta: conhe\xE7a os sintomas"
  corpo: "\u2022 Dedo m\xEDnimo arroxeado (o primeiro sinal)\n\u2022 Tremores nas
    m\xE3os\n\u2022 Febre baixa e cansa\xE7o\n\u2022 Confus\xE3o e perda de mem\xF3ria\n\nAo
    notar qualquer sintoma, procure o posto de sa\xFAde mais pr\xF3ximo. N\xE3o se
    automedique. Evite aglomera\xE7\xF5es."
  flag: mundo.doc.sintomas
  falaDepois: "Perda de mem\xF3ria... olhei pras minhas m\xE3os sem querer."
