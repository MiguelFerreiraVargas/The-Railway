  m_Script: {fileID: 11500000, guid: 027206669f9527248a1a611b91d98e03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jornal
  acao: LER JORNAL
  nomeJornal: "Folha da Esta\xE7\xE3o"
  data: "S\xE1bado, 2 de maio de 2020"
  manchete: "\"V\xEDrus Violeta\": casos dobram em uma semana"
  corpo: "Batizada de Violeta por causa da cor que deixa nas m\xE3os, a doen\xE7a
    j\xE1 soma centenas de casos no estado. Hospitais est\xE3o lotados e cirurgias
    foram suspensas.\n\nCientistas confirmam: o v\xEDrus s\xF3 atinge seres humanos.
    Os animais n\xE3o adoecem."
  flag: prologo.jornal2
  falaDepois: Violeta. Era assim que todo mundo chamava...
