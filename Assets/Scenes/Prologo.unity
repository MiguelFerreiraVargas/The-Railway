  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jornal
  acao: LER JORNAL
  nomeJornal: "Folha da Esta\xE7\xE3o"
  data: "Ter\xE7a-feira, 14 de abril de 2020"
  manchete: "Doen\xE7a misteriosa deixa o dedo m\xEDnimo roxo"
  corpo: "M\xE9dicos do hospital regional registraram o terceiro caso de uma doen\xE7a
    ainda sem nome. Os pacientes chegam com o dedo m\xEDnimo arroxeado e tremores
    nas m\xE3os.\n\nA Secretaria de Sa\xFAde pede calma: \"N\xE3o h\xE1 motivo para
    p\xE2nico\", disse o secret\xE1rio. Os casos est\xE3o sendo investigados."
  flag: prologo.jornal1
  falaDepois: "Dedo m\xEDnimo roxo... por que isso me parece familiar?"
