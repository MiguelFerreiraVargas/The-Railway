  m_Script: {fileID: 11500000, guid: 027206669f9527248a1a611b91d98e03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jornal
  acao: LER JORNAL
  nomeJornal: "Folha da Esta\xE7\xE3o"
  data: "Quarta-feira, 11 de novembro de 2020 \u2014 \xDALTIMA EDI\xC7\xC3O"
  manchete: A ferrovia para. Que Deus nos ajude.
  corpo: "Esta \xE9 a \xFAltima edi\xE7\xE3o. N\xE3o h\xE1 mais papel, nem tinta,
    nem quem entregue. A linha f\xE9rrea est\xE1 oficialmente suspensa.\n\nAos que
    ficarem: h\xE1 rumores de um grupo reunindo sobreviventes no fim da linha. Se
    for verdade, sigam os trilhos."
  flag: prologo.jornal5
  falaDepois: "\"Sigam os trilhos\"... \xE9 exatamente o que eu vou fazer."
